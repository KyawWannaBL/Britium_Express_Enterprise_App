{
  "name": "britium-express-platform",
  "private": "true",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "echo \"Add ESLint command per app\"",
    "typecheck": "echo \"Run typecheck inside each app\"",
    "dev": "cd apps/admin-web && npm run dev",
    "build": "cd apps/admin-web && npm run build",
    "start": "cd apps/admin-web && npm run start",
    "vercel-build": "cd apps/admin-web && npm run build"
  },
  "devDependencies": {
    "@prisma/config": "^7.6.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "supabase": "^2.84.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/websockets": "^11.1.18",
    "@prisma/client": "^7.6.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "mapbox-gl": "^3.21.0",
    "react-map-gl": "^8.1.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.8.1",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  }
