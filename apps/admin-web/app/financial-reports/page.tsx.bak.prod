function bi(language: UiLanguage, en: string, my: string) {
  if (language === "en") return en;
  if (language === "my") return my;
  return `${en} / ${my}`;
}

function formatMMK(value: number) {
  return `${value.toLocaleString()} MMK`;
}

// LOCAL DEV BYPASS
function hasAccess(user: any) { return true; }

export default function FinancialCenterPage() {
  const contextLanguage = (() => {
    try {
      return useLanguage()?.lang as UiLanguage | undefined;
    } catch {
      return undefined;
    }
  })();
  const auth = (() => {
    try {
      return useAuth();
    } catch {
      return undefined;
    }
  })();

  const user = auth?.user ?? {};
  const accessAllowed = hasAccess(user);

  const [language, setLanguage] = useState<UiLanguage>(
    contextLanguage === "en" ? "en" : contextLanguage === "mm" ? "my" : "both"
  );
  
  const [activeTab, setActiveTab] = useState("overview");

  if (!accessAllowed) {
    return (
      <div className="min-h-screen bg-[#f7f9fc] p-8 flex items-center justify-center">
        <div className="rounded-[32px] border border-rose-200 bg-white p-8 shadow-sm flex items-start gap-4 max-w-xl">
          <div className="rounded-2xl bg-rose-50 p-3 text-rose-600">
            <AlertTriangle size={24} />
          </div>
          <div>
            <h1 className="text-2xl font-black text-[#0d2c54]">Finance Portal Access Restricted</h1>
            <p className="mt-2 text-sm text-slate-500">
              This portal is strictly for Super Admin, Admin, and Finance team members.
            </p>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#f7f9fc] p-8 pb-24 font-sans">
      
      {/* HEADER */}
      <div className="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
        <div className="space-y-2">
          <p className="text-xs font-bold uppercase tracking-[0.3em] text-slate-400">
            {bi(language, "Finance Suite", "ငွေကြေးလုပ်ငန်းအစု")}
          </p>
          <h1 className="text-4xl font-black uppercase tracking-tight text-[#0d2c54]">
            {bi(language, "Financial Center and Accounting Workspace", "ငွေကြေးစီမံခန့်ခွဲမှုနှင့် စာရင်းကိုင်လုပ်ငန်းခွင်")}
          </h1>
          <p className="max-w-4xl text-slate-500 font-medium">
            {bi(
              language,
              "This page consolidates the BE finance and accounting screens into a cleaner bilingual operator hub for deliveryman accounting, account balances, vouchers, ledgers, cashbook summaries, and exports.",
              "ဤစာမျက်နှာသည် BE finance နှင့် accounting screen များကို deliveryman accounting၊ account balance၊ voucher၊ ledger၊ cash book summary နှင့် export များအတွက် ပိုမိုရှင်းလင်းသော ဘာသာနှစ်မျိုး operator hub အဖြစ် စုစည်းထားသည်။"
            )}
          </p>
        </div>

        <LanguageToggle value={language} onChange={setLanguage} />
      </div>

      {/* FILTER SECTION */}
      <div className="mt-8 rounded-[32px] border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex items-center gap-3 border-b border-slate-100 pb-4 mb-4">
          <Filter size={18} className="text-indigo-500" />
          <div>
            <h2 className="text-lg font-black text-[#0d2c54]">{bi(language, "Unified Finance Run Filter", "တစ်စုတစ်စည်းတည်း ငွေကြေး filter")}</h2>
            <p className="text-sm text-slate-500">{bi(language, "Single control surface for deliveryman accounting, account balance checks, voucher lists, ledger lookups, cashbook summaries, and exports.", "Deliveryman accounting၊ account balance စစ်ဆေးမှု၊ voucher list၊ ledger ရှာဖွေမှု၊ cash book summary နှင့် export များအတွက် တစ်နေရာတည်းမှ ထိန်းချုပ်နိုင်သော filter ဖြစ်သည်။")}</p>
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <FilterInput label={bi(language, "Workspace", "လုပ်ငန်းအမျိုးအစား")} placeholder={bi(language, "Deliveryman / accounts / transactions", "Deliveryman / accounts / transactions")} />
          <FilterInput label={bi(language, "Date range", "ရက်စွဲအကွာအဝေး")} placeholder="YYYY-MM-DD → YYYY-MM-DD" />
          <FilterInput label={bi(language, "Branch and zone", "Branch နှင့် zone")} placeholder={bi(language, "All branches / all zones", "Branch အားလုံး / zone အားလုံး")} />
          <FilterInput label={bi(language, "Merchant or customer", "Merchant သို့မဟုတ် customer")} placeholder={bi(language, "Optional party filter", "လိုအပ်ပါက ပါတီ filter")} />
          <FilterInput label={bi(language, "Account or voucher reference", "Account သို့မဟုတ် voucher reference")} placeholder={bi(language, "Account name, code, voucher no.", "Account name၊ code၊ voucher no.")} />
          <FilterInput label={bi(language, "Export format", "Export format")} placeholder="CSV / XLSX / PDF" />
        </div>
      </div>

      {/* TABS */}
      <div className="mt-8 flex flex-wrap gap-2">
        {financeTabs.map((tab) => (
          <button
            key={tab.id}
            onClick={() => setActiveTab(tab.id)}
            className={`rounded-2xl px-5 py-3 text-xs font-black uppercase tracking-wider transition ${
              activeTab === tab.id
                ? "bg-[#0d2c54] text-white shadow-lg"
                : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50"
            }`}
          >
            {bi(language, tab.en, tab.my)}
          </button>
        ))}
      </div>

      <div className="mt-8">
        {/* OVERVIEW TAB */}
        {activeTab === "overview" && (
          <div className="space-y-6">
            <Panel title={bi(language, "Bilingual Accounting Control Center", "ဘာသာနှစ်မျိုး စာရင်းကိုင်ထိန်းချုပ်မှုစင်တာ")}>
              <DataTable
                headers={[bi(language, "Module", "Module"), bi(language, "Purpose", "ရည်ရွယ်ချက်"), bi(language, "Source screen", "မူလ screen"), bi(language, "Status", "အခြေအနေ")]}
                rows={financeModules.map(item => [
                  <span key="1" className="font-bold text-[#0d2c54]">{bi(language, item.enModule, item.myModule)}</span>,
                  <span key="2" className="text-slate-600">{bi(language, item.enPurpose, item.myPurpose)}</span>,
                  <span key="3" className="text-slate-400 text-xs">{bi(language, item.enScreen, item.myScreen)}</span>,
                  <span key="4" className={`px-3 py-1 rounded-full text-[10px] font-black uppercase ${item.enStatus === "Ready" ? "bg-emerald-100 text-emerald-700" : item.enStatus === "Priority" ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700"}`}>
                    {bi(language, item.enStatus, item.myStatus)}
                  </span>
                ])}
              />
            </Panel>

            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Panel title={bi(language, "Voucher-entry Capability Matrix", "Voucher ဖြည့်သွင်းမှု capability matrix")}>
                <DataTable
                  headers={[bi(language, "Feature", "Feature"), bi(language, "Simple transaction", "Simple transaction"), bi(language, "Journal voucher", "Journal voucher"), bi(language, "Cash voucher", "Cash voucher")]}
                  rows={[
                    [<span key="1" className="font-bold">{bi(language, "Branch & zone filters", "Branch နှင့် zone filter")}</span>, bi(language, "Yes", "ရှိသည်"), bi(language, "Yes", "ရှိသည်"), bi(language, "Yes", "ရှိသည်")],
                    [<span key="2" className="font-bold">{bi(language, "Party selector", "Merchant / customer ရွေးချယ်ခြင်း")}</span>, bi(language, "Merchant", "Merchant"), bi(language, "Merchant + Customer", "Merchant + Customer"), bi(language, "Merchant + Customer", "Merchant + Customer")],
                    [<span key="3" className="font-bold">{bi(language, "Account line builder", "Account line builder")}</span>, bi(language, "Single account", "Single account"), bi(language, "Debit & credit lines", "Debit နှင့် credit line များ"), bi(language, "Received in / from lines", "Received in / from line များ")],
                    [<span key="4" className="font-bold">{bi(language, "Reference photos", "Reference photo များ")}</span>, bi(language, "Up to 3", "၃ ပုံထိ"), bi(language, "Up to 3", "၃ ပုံထိ"), bi(language, "Up to 3", "၃ ပုံထိ")],
                  ]}
                />
              </Panel>

              <div className="space-y-6">
                <Panel title={bi(language, "Suggested Data Views / API Contracts", "အကြံပြု data view / API contract များ")}>
                  <div className="grid grid-cols-1 gap-2">
                    {backendViews.map(view => (
                      <div key={view} className="flex items-center gap-3 bg-slate-50 border border-slate-100 rounded-xl p-3 text-sm font-mono text-slate-600">
                        <Database size={14} className="text-blue-400" /> {view}
                      </div>
                    ))}
                  </div>
                </Panel>

                <Panel title={bi(language, "Recommended Export Formats", "အကြံပြု export format များ")}>
                  <div className="space-y-3">
                    {exportFormats.map(([en, myLabel, myDesc]) => (
                      <div key={en} className="flex items-center gap-4 bg-slate-50 border border-slate-100 rounded-xl p-4">
                        <div className="bg-[#0d2c54] text-white rounded-lg p-2"><Download size={16}/></div>
                        <div>
                          <p className="font-black text-[#0d2c54]">{en}</p>
                          <p className="text-xs text-slate-500 mt-1">{bi(language, myLabel, myDesc)}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </Panel>
              </div>
            </div>

            <Panel title={bi(language, "Production Notes", "Production မှတ်ချက်များ")}>
              <ul className="space-y-3">
                {[
                  bi(language, "Keep deliveryman accounting as a tabbed summary with search and transfer-focused columns.", "Deliveryman accounting ကို search ပါဝင်ပြီး transfer ကိုအဓိကထားသည့် column များနှင့် tabbed summary အဖြစ်ထားရှိပါ။"),
                  bi(language, "Use date, branch, and zone filters consistently across account balance, general ledger, and cash book screens.", "Account balance၊ general ledger နှင့် cash book screen များတွင် date, branch, zone filter များကို တူညီစွာအသုံးပြုပါ။"),
                  bi(language, "Support image evidence upload on all voucher-entry flows, matching the three-reference-photo pattern in the uploaded screens.", "Upload screen များတွင်မြင်ရသည့် reference photo သုံးပုံ pattern အတိုင်း voucher-entry flow အားလုံးတွင် image evidence upload ကိုပံ့ပိုးပါ။"),
                  bi(language, "Prepare list outputs with pagination, export, and keyword search for journal and cash voucher histories.", "Journal နှင့် cash voucher history များအတွက် pagination၊ export နှင့် keyword search ပါဝင်သော list output များပြုလုပ်ပါ။")
                ].map((note, idx) => (
                  <li key={idx} className="flex items-start gap-3 bg-blue-50/50 p-4 rounded-xl border border-blue-100">
                    <CheckCircle2 size={18} className="text-blue-500 mt-0.5 flex-shrink-0" />
                    <span className="text-sm font-medium text-slate-700">{note}</span>
                  </li>
                ))}
              </ul>
            </Panel>
          </div>
        )}

        {/* DELIVERYMAN ACCOUNTING TABS (COD / PREPAID) */}
        {activeTab !== "overview" && (
          <Panel title={financeTabs.find(t => t.id === activeTab)?.en || "Deliveryman Accounting"}>
            <DataTable
              headers={[
                bi(language, "Deliveryman", "ပို့ဆောင်သူ"),
                bi(language, "Branch", "ဘဏ်ခွဲ"),
                bi(language, "Amount", "ငွေပမာဏ"),
                bi(language, "Status", "အခြေအနေ"),
                bi(language, "Action", "လုပ်ဆောင်ချက်")
              ]}
              rows={MOCK_DELIVERYMEN.filter(d => {
                if (activeTab === "cod_hand") return d.codHand > 0;
                if (activeTab === "cod_transferred") return d.codTransferred > 0;
                if (activeTab === "cod_pending") return d.codPending > 0;
                if (activeTab === "prepaid_hand") return d.prepaidHand > 0;
                if (activeTab === "prepaid_transferred") return d.prepaidTransferred > 0;
                return true;
              }).map(d => {
                let amt = 0;
                if (activeTab === "cod_hand") amt = d.codHand;
                if (activeTab === "cod_transferred") amt = d.codTransferred;
                if (activeTab === "cod_pending") amt = d.codPending;
                if (activeTab === "prepaid_hand") amt = d.prepaidHand;
                if (activeTab === "prepaid_transferred") amt = d.prepaidTransferred;

                return [
                  <div key="1" className="flex items-center gap-3">
                    <div className="bg-slate-100 p-2 rounded-full"><Wallet size={16} className="text-slate-500"/></div>
                    <span className="font-bold text-[#0d2c54]">{d.name}</span>
                  </div>,
                  <span key="2" className="text-slate-600">{d.branch}</span>,
                  <span key="3" className="font-black text-emerald-600">{formatMMK(amt)}</span>,
                  <span key="4" className="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-[10px] font-black uppercase">Active</span>,
                  <button key="5" className="text-xs font-bold text-blue-600 bg-blue-50 px-3 py-2 rounded-lg hover:bg-blue-100">Review</button>
                ];
              })}
            />
          </Panel>
        )}
      </div>
    </div>
  );
}

// --- SUBCOMPONENTS ---

function LanguageToggle({ value, onChange }: { value: UiLanguage; onChange: (value: UiLanguage) => void }) {
  const items: Array<{ value: UiLanguage; label: string }> = [
    { value: "en", label: "EN" },
    { value: "my", label: "မြန်မာ" },
    { value: "both", label: "EN + မြန်မာ" },
  ];

  return (
    <div className="inline-flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
      <div className="flex items-center gap-2 rounded-xl bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-500">
        <Globe2 size={14} />
        <span>Language</span>
      </div>
      {items.map((item) => (
        <button
          key={item.value}
          onClick={() => onChange(item.value)}
          className={`rounded-xl px-3 py-2 text-sm font-semibold transition ${item.value === value ? "bg-[#0d2c54] text-white shadow" : "bg-slate-50 text-slate-600 hover:bg-slate-100"}`}
        >
          {item.label}
        </button>
      ))}
    </div>
  );
}

function FilterInput({ label, placeholder }: { label: string, placeholder: string }) {
  return (
    <div>
      <label className="block text-[11px] font-black uppercase tracking-[0.2em] text-slate-400 mb-2">{label}</label>
      <input 
        placeholder={placeholder}
        className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 outline-none focus:border-[#0d2c54] focus:bg-white"
      />
    </div>
  );
}

function Panel({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <div className="rounded-[32px] border border-slate-200 bg-white p-6 shadow-sm">
      <h2 className="text-lg font-black text-[#0d2c54] border-b border-slate-100 pb-4">{title}</h2>
      <div className="mt-4">{children}</div>
    </div>
  );
}

function DataTable({ headers, rows, emptyText = "No records found." }: { headers: string[], rows: React.ReactNode[][], emptyText?: string }) {
  return (
    <div className="overflow-hidden rounded-[24px] border border-slate-200">
      <div className="overflow-x-auto">
        <table className="min-w-full text-sm">
          <thead className="bg-slate-50 text-left text-slate-500">
            <tr>
              {headers.map((header) => (
                <th key={header} className="px-5 py-4 text-xs font-black uppercase tracking-wider">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody className="bg-white">
            {rows.length === 0 ? (
              <tr>
                <td colSpan={headers.length} className="px-5 py-12 text-center text-slate-400 font-semibold">
                  {emptyText}
                </td>
              </tr>
            ) : (
              rows.map((row, idx) => (
                <tr key={idx} className="border-t border-slate-100 hover:bg-slate-50/50 transition">
                  {row.map((cell, cellIdx) => (
                    <td key={cellIdx} className="px-5 py-4 align-middle">{cell}</td>
                  ))}
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}